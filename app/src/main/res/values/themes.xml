<resources>
    <style name="Theme.TvTestProject" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mirror_accent</item>
        <item name="colorPrimaryVariant">@color/mirror_accent</item>
        <item name="colorOnPrimary">@color/mirror_background</item>
        <item name="colorSecondary">@color/mirror_cyan</item>
        <item name="colorOnSecondary">@color/mirror_background</item>
        <item name="colorSurface">@color/mirror_surface</item>
        <item name="colorOnSurface">@color/mirror_text</item>
        <item name="android:colorBackground">@color/mirror_background</item>
        <item name="android:windowBackground">@color/mirror_background</item>
        <item name="android:statusBarColor">@color/mirror_background</item>
        <item name="android:navigationBarColor">@color/mirror_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Mirror.Action" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">52dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:focusable">true</item>
        <item name="cornerRadius">6dp</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/mirror_button_stroke</item>
        <item name="backgroundTint">@color/mirror_primary_fill</item>
        <item name="android:textColor">@color/mirror_background</item>
        <item name="iconTint">@color/mirror_background</item>
        <item name="iconSize">22dp</item>
        <item name="iconPadding">10dp</item>
        <item name="rippleColor">#30627220</item>
    </style>
    <style name="Mirror.Icon" parent="Mirror.Action">
        <item name="backgroundTint">@color/mirror_secondary_fill</item>
        <item name="iconTint">@color/mirror_secondary_content</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="rippleColor">#408BDCE6</item>
    </style>
</resources>
